  /* ─── 카드 및 배지 스타일 ─── */
  .status-badge {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 12px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.3px;
  }
  .badge-ready    { background: #d1fae5; color: #065f46; }
