"{% extends \"admin_base.html\" %}\n\n{% block page_title %}크롤링 파이프라인 모니터링{% endblock %}\n\n{% block content %}\n<style>\n  /* ─── 카드 및 배지 스타일 ─── */\n  .status-badge {\n    display: inline-flex;\n    align-items: center;\n    gap: 6px;\n    padding: 4px 12px;\n    border-radius: 20px;\n    font-size: 0.75rem;\n    font-weight: 600;\n    letter-spacing: 0.3px;\n  }\n  .badge-ready    { background: #d1fae5; color: #065f46; }\n  .badge-waiting  { background: #fef3c7; color: #92400e; }\n  .badge-img-missing { background: #fee2e2; color: #991b1b; }\n  .badge-empty    { background: #f3f4f6; color: #6b7280; }\n  .badge-running  { background: #dbeafe; color: #1e40af; }\n  .badge-blocked  { background: #fce7f3; color: #9d174d; }\n  .badge-success  { background: #d1fae5; color: #065f46; }\n  .badge-failed   { background: #fee2e2; color: #991b1b; }\n  .badge-unknown  { background: #f3f4f6; color: #6b7280; }\n\n  /* ─── 상단 요약 카드 ─── */\n  .summary-card {\n    border-radius: 14px;\n    border: none;\n    padding: 22px 26px;\n    background: #fff;\n    box-shadow: 0 1px 8px rgba(0,0,0,.08);\n    transition: transform .15s;\n  }\n  .summary-card:hover { transform: translateY(-2px); }\n  .summary-card .icon-wrap {\n    width: 48px; height: 48px;\n    border-radius: 12px;\n    display: flex; align-items: center; justify-content: center;\n    font-size: 1.3rem;\n  }\n  .icon-blue   { background: #dbeafe; color: #1d4ed8; }\n  .icon-green  { background: #d1fae5; color: #059669; }\n  .icon-yellow { background: #fef9c3; color: #b45309; }\n  .icon-red    { background: #fee2e2; color: #dc2626; }\n\n  /* ─── 브랜드 카드 ─── */\n  .brand-card {\n    border-radius: 14px;\n    border: 1px solid #e5e7eb;\n    background: #fff;\n    transition: box-shadow .15s;\n  }\n  .brand-card:hover { box-shadow: 0 4px 18px rgba(0,0,0,.1); }\n  .brand-card .card-header {\n    border-radius: 14px 14px 0 0;\n    background: linear-gradient(135deg, #1e40af 0%, #7c3a
